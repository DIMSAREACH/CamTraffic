# Docker Compose environment — copy to `.env.docker` at repo root
# Usage: docker compose --env-file .env.docker up -d --build

# ── PostgreSQL (docker-compose service: postgres) ─────────────────
DB_NAME=camtraffic_db
DB_USER=camtraffic
DB_PASSWORD=camtraffic_secret
DB_HOST=postgres
DB_PORT=5432
USE_SQLITE=False

# ── Redis (docker-compose service: redis) ─────────────────────────
USE_REDIS=True
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── Django backend ────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-docker-dev-secret-key-min-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DOCKER=1

# CORS — Vite / Docker SPA hosts (frontend-user :5173, frontend-admin :5174)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# SPA host ports (docker-compose frontend-* services)
FRONTEND_USER_PORT=5173
FRONTEND_ADMIN_PORT=5174

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── AI (place weights in ai/weights/ for real YOLO; never mock in compose prod path) ──
AI_DETECTION_MODE=local
AI_MODEL_PATH=../ai/weights/best.pt
AI_USE_MOCK=False
AI_PIPELINE_DEMO_VIOLATION=False
AI_VEHICLE_ENABLED=True
AI_VEHICLE_MODEL=best_cambodia_vehicles.pt
AI_PLATE_OCR_ENABLED=True
AI_PLATE_DETECT_ENABLED=True
AI_PLATE_DETECT_MODEL=best_cambodia_plates.pt

# ── Stream gateway / cameras ──────────────────────────────────────
STREAM_GATEWAY_URL=http://stream-gateway:8082
STREAM_MOCK_MODE=false
DEMO_CAMERA_FRAMES_ENABLED=false

# ── Payments (KHQR merchant required so demo_fallback=false) ──────
PAYMENT_MODE=live
PAYMENT_MANUAL_PROOF_ENABLED=True
KHQR_MERCHANT_NAME=CamTraffic
KHQR_MERCHANT_ACCOUNT=
KHQR_MERCHANT_ACCOUNT_KHR=

# Demo seed off even for local docker when mimicking production
ALLOW_DEMO_SEED=False
CAMTRAFFIC_SEED_DEMO=False

# ── Email (optional for local Docker) ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# API docs in dev
ENABLE_API_DOCS=True
