# Dev: use /api so Vite proxies to Django (see VITE_API_PROXY_TARGET)
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_USE_MOCK=false
# Production truth: keep false. Dev-only opt-in to merge demo rows when APIs return empty.
VITE_USE_SAMPLE_FALLBACK=false
# Thesis-only: demo violation override + /demo-signs quick chips (never enable for production)
VITE_ALLOW_DEMO_VIOLATION=false
VITE_ALLOW_DEMO_ASSETS=false
VITE_PORTAL_SURFACE=admin
VITE_USER_PORT=5173
VITE_ADMIN_PORT=5174
