# CamTraffic user portal (officer + driver Vite SPA) — local Docker Compose
# Serves on :80 inside the container; map host 5173:80

FROM node:22-bookworm-slim AS build
WORKDIR /src

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY packages/store ./packages/store
COPY packages/query ./packages/query
COPY packages/types ./packages/types
COPY src/web/user ./src/web/user

RUN npm ci -w src/web/user --ignore-scripts || npm install -w src/web/user --ignore-scripts

WORKDIR /src/src/web/user
ENV VITE_API_URL=/api \
    VITE_USE_MOCK=false \
    VITE_USE_SAMPLE_FALLBACK=false \
    VITE_ALLOW_DEMO_VIOLATION=false \
    VITE_ALLOW_DEMO_ASSETS=false \
    VITE_PORTAL_SURFACE=user
RUN npm run build

FROM nginx:1.27-alpine
COPY infra/docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/src/web/user/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
